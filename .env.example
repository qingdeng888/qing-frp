# frp-console 0.0.1 部署配置示例
# 复制为 .env 后按需修改：cp .env.example .env

# ---- 面板登录（生产务必修改密码）----
PANEL_USER=admin
PANEL_PASSWORD=请改成强密码

# ---- 面板对外地址（生成安装脚本时用）----
# 必须是节点能访问到的地址，留空会探测到内网 IP 导致外部节点连不上
PUBLIC_URL=http://你的公网IP:37000

# ---- 端口 ----
PANEL_PORT=37000

# ---- Docker 镜像版本标签（会自动写入 OCI label）----
APP_VERSION=0.0.1

# ---- 国内网络构建时可启用以下镜像源 ----
# NPM_REGISTRY=https://registry.npmmirror.com
# APK_MIRROR=mirrors.aliyun.com
# BASE_IMAGE=docker.m.daocloud.io/library/node:22-alpine
